{
  "name": "balloons",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Competitive intelligence product (slices + reporting) — separate from warehouse (btw-wh-server)",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "ci": "npm run format:check && npm run lint && npm run test:run && npm run build",
    "dev:api": "npm run dev -w @balloons/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
