{
  "name": "@balloons/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:app && npm run build:content",
    "build:app": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@balloons/web-api-client": "*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
